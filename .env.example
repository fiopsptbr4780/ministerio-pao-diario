# Configuração para gerar_mensagens_com_ia.py
# Copie este arquivo para .env e preencha suas chaves
# NÃO commite este arquivo no git!

# OpenRouter (gratuito com conta)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_aqui

# NVIDIA NIM (gratuito com conta NVIDIA)
# Obtenha em: https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_aqui

# Ollama local (não precisa de chave, só rodar: ollama serve)
# Modelos locais: ollama pull qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Configurações padrão
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3:4b-instruct
DEFAULT_LIMIT=20